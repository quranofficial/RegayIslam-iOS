<?xml version="1.0" encoding="utf-8"?>
<!-- Item 4 — restyled daily-ayah widget: ornamental header, centred ayah
     text with tashkeel spacing, gold reference footer.
     Remote-view IDs unchanged (AyahWidgetProvider reads them). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ayah_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <!-- Ornamental header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#4CC8A24B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="﴾ ئایەتی ڕۆژ ﴿"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#4CC8A24B" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_ayah_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.8" />

    <!-- Footer: gold rule + reference -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="#40C8A24B" />

    <TextView
        android:id="@+id/widget_ayah_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#CCFFD54F"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
